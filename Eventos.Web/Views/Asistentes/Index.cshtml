@model IEnumerable<Eventos.Web.Models.Asistente>

@{
    ViewData["Title"] = "Directorio de Asistentes";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-people me-2 text-warning"></i>Directorio de Asistentes</h2>
            <p class="text-muted mb-0">Listado de asistentes activos registrados en la plataforma (ordenados por nombres)</p>
        </div>
        <a asp-action="Create" class="btn btn-dark fw-bold px-4 py-2 mt-2 mt-sm-0">
            <i class="bi bi-person-plus-fill me-1"></i> Registrar Asistente
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Nombres</th>
                            <th>DNI</th>
                            <th>Correo Electrónico</th>
                            <th>Teléfono</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                                    No hay asistentes registrados o activos en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-dark">
                                        <i class="bi bi-person-circle text-secondary me-2"></i>@item.Nombres
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.Dni</span>
                                    </td>
                                    <td>
                                        <a href="mailto:@item.Correo" class="text-decoration-none">@item.Correo</a>
                                    </td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono)
                                    </td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i>Activo
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('¿Está seguro de eliminar lógicamente este asistente?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Eliminar lógicamente">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

