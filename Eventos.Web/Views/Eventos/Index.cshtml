@model IEnumerable<Eventos.Web.Models.Evento>

@{
    ViewData["Title"] = "Eventos Especiales";
    var categorias = ViewBag.Categorias as List<Eventos.Web.Models.Categoria> ?? new List<Eventos.Web.Models.Categoria>();
    int? categoriaSeleccionadaId = ViewBag.CategoriaSeleccionadaId as int?;
    bool esAdmin = Context.Session.GetString("ModoAdmin") == "true";

    // Imágenes fotográficas locales de alta calidad
    var cardImages = new[]
    {
        "/images/eventos/evento1.jpg",
        "/images/eventos/evento2.jpg",
        "/images/eventos/evento3.jpg",
        "/images/eventos/evento4.jpg",
        "/images/eventos/evento5.jpg",
        "/images/eventos/evento6.jpg"
    };
    int imgIndex = 0;
}

<!-- Hero Title Section -->
<section class="fsinca-hero">
    <div class="container">
        <h1 class="fsinca-main-title">FSINCA EVENTS</h1>
        <div class="mt-2">
            <span class="fsinca-subtitle-pill">REUNIONES ESPECIALES</span>
        </div>
    </div>
</section>

<!-- Yellow Categories & Events Section -->
<section class="fsinca-yellow-section">
    <div class="container">
        <!-- Categories Title & Filter Pills -->
        <div class="text-center mb-5">
            <h2 class="fsinca-categories-title">CATEGORIAS</h2>
            <div class="d-flex flex-wrap justify-content-center align-items-center mt-3">
                <a asp-action="Index" 
                   class="category-pill @(!categoriaSeleccionadaId.HasValue || categoriaSeleccionadaId == 0 ? "active" : "")">
                    TODOS
                </a>
                @foreach (var cat in categorias)
                {
                    <a asp-action="Index" asp-route-categoriaId="@cat.Id" 
                       class="category-pill @(categoriaSeleccionadaId == cat.Id ? "active" : "")">
                        @cat.Nombre
                    </a>
                }
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-3 shadow-sm p-4 mx-auto" style="max-width: 600px;">
                <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
                <h4 class="fw-bold">No se encontraron eventos activos</h4>
                <p class="text-muted">No hay eventos registrados en esta categoría en este momento.</p>
                @if (esAdmin)
                {
                    <a asp-action="Create" class="btn btn-dark mt-2">
                        <i class="bi bi-plus-circle me-1"></i> Publicar Nuevo Evento
                    </a>
                }
            </div>
        }
        else
        {
            <!-- Cards Grid: 3 columnas (idéntico a la maqueta con fotos reales) -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in Model)
                {
                    var imgSrc = cardImages[imgIndex % cardImages.Length];
                    imgIndex++;

                    int inscritos = item.Inscripciones?.Count(i => i.Estado == "Confirmada") ?? 0;
                    int cuposDisponibles = Math.Max(0, item.Aforo - inscritos);

                    <div class="col">
                        <div class="fsinca-card">
                            <!-- Card Header Image con Fotografía Real Local -->
                            <div class="fsinca-card-img-wrapper position-relative">
                                <img src="@imgSrc" alt="@item.Titulo" style="width: 100%; height: 210px; object-fit: cover;" />
                                <span class="position-absolute top-0 end-0 m-2 badge @(item.Modalidad == "Presencial" ? "bg-dark" : "bg-primary") shadow">
                                    <i class="bi @(item.Modalidad == "Presencial" ? "bi-building" : "bi-laptop") me-1"></i>@item.Modalidad
                                </span>
                            </div>

                            <!-- Card Body -->
                            <div class="fsinca-card-body">
                                <div class="fsinca-venue-tag">
                                    <i class="bi bi-geo-alt-fill me-1 text-danger"></i>@item.Lugar
                                </div>
                                <h3 class="fsinca-card-title" title="@item.Titulo">
                                    @item.Titulo
                                </h3>

                                <div class="small text-muted mb-2">
                                    <i class="bi bi-calendar3 me-1"></i>@item.Fecha.ToString("dd/MM/yyyy HH:mm") hrs
                                </div>

                                <!-- Métricas: Inscritos Confirmados y Cupos Disponibles -->
                                <div class="fsinca-cupos-info bg-light p-2 rounded mb-3">
                                    <div>
                                        <i class="bi bi-people-fill text-primary me-1"></i>
                                        <strong>@inscritos</strong> inscritos
                                    </div>
                                    <div class="ms-auto">
                                        <i class="bi bi-check2-circle text-success me-1"></i>
                                        <strong class="@(cuposDisponibles == 0 ? "text-danger" : "text-success")">
                                            @cuposDisponibles
                                        </strong> cupos libres
                                    </div>
                                </div>

                                <!-- Card Footer Strip -->
                                <div class="fsinca-card-footer-strip">
                                    <div class="fsinca-price-badge">
                                        S/ @item.Precio.ToString("N2") <span style="font-size: 0.72rem; font-weight: normal;">/ cupo</span>
                                    </div>
                                    <div class="fsinca-category-tag">
                                        *@(item.Categoria?.Nombre ?? "General")
                                    </div>
                                </div>

                                <!-- Acciones: Adaptativo según Modo Asistente vs Modo Admin -->
                                <div class="mt-3 pt-2 border-top">
                                    @if (!esAdmin)
                                    {
                                        <!-- VISTA ASISTENTE (Limpia y profesional) -->
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark flex-grow-1">
                                                <i class="bi bi-info-circle me-1"></i> Ver Detalle
                                            </a>
                                            <a asp-controller="Inscripciones" asp-action="Create" asp-route-eventoId="@item.Id" class="btn btn-sm btn-warning text-dark fw-bold px-3">
                                                <i class="bi bi-ticket-perforated-fill me-1"></i> Inscribirme
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- VISTA ADMINISTRADOR (CRUD completo) -->
                                        <div class="d-flex gap-2">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary flex-grow-1" title="Ver detalles">
                                                <i class="bi bi-eye"></i> Detalle
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar (lógico)">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                            <a asp-controller="Inscripciones" asp-action="Create" asp-route-eventoId="@item.Id" class="btn btn-sm btn-dark" title="Inscribir">
                                                <i class="bi bi-ticket-perforated"></i>
                                            </a>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
