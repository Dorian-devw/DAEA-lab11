@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Detalle del Evento";
    int inscritosConfirmados = ViewBag.InscritosConfirmados ?? 0;
    int cuposDisponibles = Math.Max(0, Model.Aforo - inscritosConfirmados);
    bool esAdmin = Context.Session.GetString("ModoAdmin") == "true";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2 text-warning"></i>Detalles del Evento</h4>
                    <div>
                        @if (esAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm me-1">
                                <i class="bi bi-pencil me-1"></i>Editar
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm me-1">
                                <i class="bi bi-trash me-1"></i>Eliminar
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-arrow-left me-1"></i>Regresar al Catálogo
                        </a>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-8">
                            <span class="badge bg-secondary mb-2">@Model.Categoria?.Nombre</span>
                            <span class="badge @(Model.Modalidad == "Presencial" ? "bg-dark" : "bg-primary") mb-2">@Model.Modalidad</span>
                            <h2 class="fw-bold mb-3">@Model.Titulo</h2>
                            <p class="text-muted"><i class="bi bi-geo-alt-fill text-danger me-1"></i> <strong>Lugar:</strong> @Model.Lugar</p>
                            <p class="text-muted"><i class="bi bi-calendar-event me-1"></i> <strong>Fecha y Hora:</strong> @Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy - HH:mm") hrs</p>
                        </div>
                        <div class="col-md-4 text-md-end">
                            <div class="p-3 bg-light rounded-3 text-center border">
                                <span class="d-block text-muted small fw-bold text-uppercase">Precio de Entrada</span>
                                <h2 class="text-danger fw-bold my-1">S/ @Model.Precio.ToString("N2")</h2>
                                <a asp-controller="Inscripciones" asp-action="Create" asp-route-eventoId="@Model.Id" class="btn btn-warning w-100 fw-bold mt-2">
                                    <i class="bi bi-ticket-perforated me-1"></i> Inscribirse Ahora
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 bg-light p-3 text-center">
                                <span class="text-muted small fw-bold">Aforo Total</span>
                                <h3 class="fw-bold text-dark mt-1">@Model.Aforo</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-light p-3 text-center">
                                <span class="text-muted small fw-bold">Inscritos Confirmados</span>
                                <h3 class="fw-bold text-primary mt-1">@inscritosConfirmados</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 bg-light p-3 text-center">
                                <span class="text-muted small fw-bold">Cupos Disponibles</span>
                                <h3 class="fw-bold @(cuposDisponibles == 0 ? "text-danger" : "text-success") mt-1">@cuposDisponibles</h3>
                            </div>
                        </div>
                    </div>

                    @if (esAdmin)
                    {
                        <!-- Solo visible para el administrador -->
                        <h5 class="fw-bold mt-4 mb-3 border-bottom pb-2">
                            <i class="bi bi-people-fill me-2 text-primary"></i>Asistentes Confirmados (@Model.Inscripciones.Count(i => i.Estado == "Confirmada"))
                        </h5>

                        @if (!Model.Inscripciones.Any(i => i.Estado == "Confirmada"))
                        {
                            <div class="alert alert-light border text-muted">
                                Aún no hay inscripciones confirmadas para este evento.
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Asistente</th>
                                            <th>DNI</th>
                                            <th>Correo</th>
                                            <th>Fecha Inscripción</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var insc in Model.Inscripciones.Where(i => i.Estado == "Confirmada"))
                                        {
                                            <tr>
                                                <td class="fw-bold">@insc.Asistente?.Nombres</td>
                                                <td>@insc.Asistente?.Dni</td>
                                                <td>@insc.Asistente?.Correo</td>
                                                <td>@insc.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td><span class="badge bg-success">@insc.Estado</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
