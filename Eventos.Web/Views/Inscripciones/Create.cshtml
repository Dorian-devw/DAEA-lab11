@model Eventos.Web.Models.Inscripcion

@{
    ViewData["Title"] = "Nueva Inscripción";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-ticket-perforated me-2 text-warning"></i>Nueva Inscripción a Evento</h4>
                    <a asp-action="Index" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Regresar
                    </a>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="EventoId" class="form-label fw-bold"></label>
                            <select asp-for="EventoId" class="form-select select2" asp-items="ViewBag.Eventos">
                                <option value="">-- Seleccionar Evento Activo --</option>
                            </select>
                            <span asp-validation-for="EventoId" class="text-danger small"></span>
                            <div class="form-text">Solo se permite la inscripción si el evento es futuro y cuenta con cupos disponibles.</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AsistenteId" class="form-label fw-bold"></label>
                            <select asp-for="AsistenteId" class="form-select select2" asp-items="ViewBag.Asistentes">
                                <option value="">-- Seleccionar Asistente Activo --</option>
                            </select>
                            <span asp-validation-for="AsistenteId" class="text-danger small"></span>
                            <div class="form-text">El asistente no debe contar con una inscripción ya confirmada para el mismo evento.</div>
                        </div>

                        <div class="alert alert-info d-flex align-items-center small">
                            <i class="bi bi-shield-check fs-4 me-2"></i>
                            <div>
                                La inscripción se registrará automáticamente en estado <strong>Confirmada</strong> con la fecha y hora actual del sistema.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-controller="Asistentes" asp-action="Create" class="text-decoration-none small text-primary fw-bold">
                                <i class="bi bi-person-plus me-1"></i>¿El asistente no existe? Registrar aquí
                            </a>
                            <div class="d-flex gap-2">
                                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-warning fw-bold px-4 text-dark">
                                    <i class="bi bi-check2-circle me-1"></i> Confirmar Inscripción
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

